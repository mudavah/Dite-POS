generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  SPLIT
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  DAMAGE
  OPENING_STOCK
}

enum ReceiptStatus {
  GENERATED
  PRINTED
  REPRINTED
  VOIDED
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  FAILED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum ImportStatus {
  PENDING
  IMPORTING
  COMPLETED
  FAILED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
   id            String    @id @default(cuid())
   name          String?
   email         String    @unique
   emailVerified DateTime?
   image         String?
   password      String?
   role          UserRole  @default(CASHIER)
   branchId      String?
   pin           String?
   tin           String?
   isActive      Boolean  @default(true)
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

  branch      Branch?        @relation(fields: [branchId], references: [id])
  accounts    Account[]
  sessions    Session[]
  sales       Sale[]
  heldSales   HeldSale[]
  auditLogs   AuditLog[]
  purchases   Purchase[]
  stockMovements StockMovement[]
  inventoryTransactions InventoryTransaction[]
  importLogs  ImportLog[]

  @@map("users")
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  inventories    Inventory[]
  sales          Sale[]
  heldSales      HeldSale[]
  stockTransfers StockTransfer[] @relation("BranchTransfers")
  stockTransfersFrom StockTransfer[] @relation("FromBranchTransfers")
  settings       BranchSetting?
  printerConfigs PrinterConfig[]
  etrsConfigs    EtrsConfig?
  purchases      Purchase[]
  transactions   InventoryTransaction[]

  @@map("branches")
}

model BranchSetting {
   id             String   @id @default(cuid())
   branchId       String   @unique
   receiptPrefix  String   @default("RCP")
   receiptNextNum Int      @default(1)
   receiptTemplate String  @default("existing")
   currency       String   @default("KES")
   currencySymbol String   @default("KSh")
   footerText     String?
   shopName       String?
   kraPin         String?
   createdAt      DateTime @default(now())
   updatedAt      DateTime @updatedAt

   branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

   @@map("branch_settings")
 }

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  barcode      String?  @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2)
  categoryId   String?
  image        String?
  isActive     Boolean  @default(true)
  isArchived   Boolean  @default(false)
  lowStockThreshold Int @default(10)
  maxStock     Int      @default(1000)
  brand        String?
  unit         String   @default("pcs")
  reorderLevel Int      @default(10)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  discount     Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id])
  inventories Inventory[]
  saleItems   SaleItem[]
  purchaseItems PurchaseItem[]
  images      ProductImage[]
  transactions InventoryTransaction[]

  @@map("products")
}

model Inventory {
  id         String   @id @default(cuid())
  branchId   String
  productId  String
  quantity   Int      @default(0)
  reserved   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  transactions InventoryTransaction[]

  @@unique([branchId, productId])
  @@map("inventories")
}

model StockMovement {
  id         String            @id @default(cuid())
  inventoryId String
  type       StockMovementType
  quantity   Int
  reference  String?
  referenceNumber String?
  notes      String?
  createdAt  DateTime          @default(now())
  createdById String

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [createdById], references: [id])

  @@map("stock_movements")
}

model StockTransfer {
  id          String        @id @default(cuid())
  fromBranchId String
  toBranchId   String
  productId    String
  quantity     Int
  status       TransferStatus @default(PENDING)
  notes        String?
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  createdById  String

  fromBranch Branch @relation("FromBranchTransfers", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("BranchTransfers", fields: [toBranchId], references: [id])

  @@map("stock_transfers")
}

model Sale {
   id              String        @id @default(cuid())
   branchId        String
   cashierId       String
   customerId      String?
   customerName    String?
   customerPhone   String?
   customerPin     String?
   customerTin     String?
   subtotal        Decimal       @db.Decimal(10, 2)
   discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
   totalAmount     Decimal       @db.Decimal(10, 2)
   paymentMethod   PaymentMethod
   paymentStatus   PaymentStatus @default(PENDING)
   amountPaid      Decimal       @default(0) @db.Decimal(10, 2)
   changeAmount    Decimal       @default(0) @db.Decimal(10, 2)
   notes           String?
   createdAt       DateTime      @default(now())
   updatedAt       DateTime      @updatedAt

   branch    Branch      @relation(fields: [branchId], references: [id])
   cashier   User        @relation(fields: [cashierId], references: [id])
   items     SaleItem[]
   payments  Payment[]
   receipts  Receipt[]

   @@map("sales")
 }

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  productName String
  sku        String?
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  reference    String?
  createdAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model HeldSale {
  id          String   @id @default(cuid())
  branchId    String
  cashierId   String
  customerName String?
  itemsJson   String   @db.Text
  subtotal    Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  cashier User  @relation(fields: [cashierId], references: [id])

  @@map("held_sales")
}

model Receipt {
  id          String        @id @default(cuid())
  saleId      String        @unique
  receiptNo   String
  branchId    String
  status      ReceiptStatus @default(GENERATED)
  printedAt   DateTime?
  reprintedAt DateTime?
  voidedAt    DateTime?
  createdAt   DateTime      @default(now())

  sale   Sale       @relation(fields: [saleId], references: [id])
  etrs   EtrsReceipt?

  @@map("receipts")
}

model EtrsReceipt {
  id             String   @id @default(cuid())
  receiptId      String   @unique
  receiptRef     String   @unique
  cuUrl          String?
  receiptType    String   @default("INVOICE")
  metadata       String?  @db.Text
  isSynced       Boolean  @default(false)
  syncedAt       DateTime?
  createdAt      DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("etrs_receipts")
}

model PrinterConfig {
  id         String   @id @default(cuid())
  branchId   String
  name       String
  type       String   @default("USB")
  protocol   String   @default("ESC_POS")
  paperSize  String   @default("80mm")
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  vendorId   String?
  productId  String?
  endpoint   String?
  deviceId   String?
  ipAddress  String?
  macAddress String?
  port       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("printer_configs")
}

model EtrsConfig {
  id            String   @id @default(cuid())
  branchId      String   @unique
  deviceId      String?
  isActive      Boolean  @default(false)
  isSimulated   Boolean  @default(true)
  deviceName    String?
  lastConnected DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("etrs_configs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValues String?  @db.Text
  newValues String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Supplier {
  id          String      @id @default(cuid())
  name        String
  companyName String?
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?
  kraPin      String?
  notes       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  purchases  Purchase[]

  @@map("suppliers")
  @@index([name])
  @@index([status])
  @@index([email])
}

model ImportLog {
  id          String     @id @default(cuid())
  userId      String
  fileName    String
  totalRows   Int
  imported    Int
  updated     Int
  skipped     Int
  failed      Int
  duplicates  Int
  errors      String     @db.Text
  status      ImportStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  user User @relation(fields: userId, references: [id], onDelete: Cascade)

  @@map("import_logs")
}

model Purchase {
  id              String        @id @default(cuid())
  purchaseNumber  String        @unique
  supplierId      String
  branchId        String
  userId          String
  purchaseDate    DateTime      @default(now())
  invoiceNumber   String?
  deliveryNote    String?
  paymentMethod   PaymentMethod
  status          PurchaseStatus  @default(DRAFT)
  notes           String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(10, 2)
  outstandingBalance Decimal    @default(0) @db.Decimal(10, 2)
  receivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  items      PurchaseItem[]
  attachments PurchaseAttachment[]

  @@map("purchases")
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([purchaseDate])
  @@index([purchaseNumber])
  @@index([invoiceNumber])
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  productId   String?
  productName String
  sku         String?
  barcode     String?
  quantity    Int
  buyingPrice Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@map("purchase_items")
  @@index([purchaseId])
  @@index([productId])
}

model PurchaseAttachment {
  id        String   @id @default(cuid())
  purchaseId String
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String?
  uploadedBy String
  createdAt DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_attachments")
  @@index([purchaseId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@index([productId])
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  inventoryId String
  productId   String
  branchId    String
  type        StockMovementType
  quantity    Int
  previousStock Int
  newStock    Int
  referenceNumber String?
  notes       String?
  createdAt   DateTime @default(now())
  createdById String

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  user      User?     @relation(fields: [createdById], references: [id])

  @@map("inventory_transactions")
  @@index([inventoryId])
  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
  @@index([referenceNumber])
}

model SyncQueue {
  id         String     @id @default(cuid())
  entityType String
  entityId   String
  action     String
  payload    String     @db.Text
  status     SyncStatus @default(PENDING)
  retries    Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("sync_queue")
}
