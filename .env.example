# Database
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=verify-full&channel_binding=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-app.vercel.app"

# App
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="Dite POS"

# Environment - do NOT hardcode NODE_ENV; set it in your deployment/CI
LOG_LEVEL="info"

# Seed Script (optional - do NOT store real passwords here)
SEED_ADMIN_PASSWORD="change-me-in-production"
SEED_CASHIER_PASSWORD="change-me-in-production"
